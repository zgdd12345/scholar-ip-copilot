{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-ip-copilot/schemas/project.schema.json",
  "title": "EviDraft project descriptor",
  "description": "Validates the on-disk file `.evidraft/project.yaml` of an EviDraft project.",
  "type": "object",
  "required": ["project_type", "title", "status", "artifacts", "rules"],
  "additionalProperties": false,
  "properties": {
    "project_type": { "$ref": "#/$defs/project_type" },
    "title":         { "type": "string" },
    "field":         { "type": "string" },
    "target_venue":  { "type": "string" },
    "language":      { "type": "string", "default": "en" },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":        { "type": "string" },
          "affiliation": { "type": "string" },
          "orcid":       { "type": "string" },
          "email":       { "type": "string", "format": "email" }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "literature":  { "$ref": "#/$defs/stage" },
        "idea":        { "$ref": "#/$defs/stage" },
        "codebase":    { "$ref": "#/$defs/stage" },
        "experiments": { "$ref": "#/$defs/stage" },
        "manuscript":  { "$ref": "#/$defs/stage" },
        "patent":      { "$ref": "#/$defs/stage" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence":             { "type": "string" },
        "bib":                  { "type": "string" },
        "manuscript":           { "type": "string" },
        "invention_disclosure": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_citation_for_claims":         { "type": "boolean", "default": true },
        "require_experiment_source_for_numbers": { "type": "boolean", "default": true },
        "require_code_trace_for_code_claims":  { "type": "boolean", "default": true },
        "allow_unverified_claims":             { "type": "boolean", "default": false }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citation_guard":             { "$ref": "#/$defs/hook_mode" },
        "evidence_consistency":       { "$ref": "#/$defs/hook_mode" },
        "latex_compile":              { "$ref": "#/$defs/hook_mode" },
        "sensitive_file_guard":       { "$ref": "#/$defs/hook_mode" },
        "scope_required":             { "$ref": "#/$defs/hook_mode" },
        "external_write_zone":        { "$ref": "#/$defs/hook_mode" },
        "humanize_evidence_preserve": { "$ref": "#/$defs/hook_mode" }
      }
    },
    "scope": {
      "type": "object",
      "description": "Brainstorming / scope-clarification settings consumed by /scholar:brainstorming and the scope-required hook.",
      "additionalProperties": false,
      "properties": {
        "required":       { "type": "boolean", "default": true },
        "staleness_days": { "type": "integer", "default": 14, "minimum": 1 }
      }
    },
    "style": {
      "type": "object",
      "description": "Style / polish settings consumed by /scholar:polish (Williams-style humanize).",
      "additionalProperties": false,
      "properties": {
        "humanize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model":              { "type": "string", "description": "Provider:model id. Env-var auth, never embed keys." },
            "fallback_chain":     { "type": "array", "items": { "type": "string" } },
            "preserve_citations": { "type": "boolean", "default": true },
            "max_delta_ratio":    { "type": "number", "default": 0.35, "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "reviewers": {
      "type": "object",
      "description": "External-agent review settings consumed by /scholar:xreview.",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "array", "items": { "$ref": "#/$defs/external_agent" } }
      }
    },
    "lit_deep": {
      "type": "object",
      "description": "Heavy literature workflow settings consumed by /scholar:deepresearch.",
      "additionalProperties": false,
      "properties": {
        "breadth":   { "type": "integer", "default": 6, "minimum": 1, "maximum": 12, "description": "Max sub-queries per fan-out. Worst-case candidate count is breadth*50; cap at 12 to bound budget." },
        "depth":     { "type": "integer", "default": 2, "minimum": 1, "maximum": 3,  "description": "Recursive follow-up depth. Bound at 3 to avoid exponential token blow-up." },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/lit_provider" } }
      }
    },
    "paper": {
      "type": "object",
      "description": "Paper-side extension fields (used when project_type ∈ paper, mixed).",
      "additionalProperties": false,
      "properties": {
        "draft_style": { "type": "string", "default": "arxiv" },
        "submission_dir": { "type": "string" }
      }
    },
    "patent": {
      "type": "object",
      "description": "Patent-side extension fields (used when project_type ∈ patent, mixed).",
      "additionalProperties": false,
      "properties": {
        "jurisdiction": {
          "type": "string",
          "enum": ["US", "EP", "CN", "JP", "PCT", "OTHER"],
          "default": "US"
        },
        "primary_deliverable": { "type": "string", "default": "invention_disclosure", "description": "Constant for v0.1; future-proof if patent_review or claims becomes the primary deliverable." }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "string",
      "enum": ["not_started", "in_progress", "done"]
    },
    "hook_mode": {
      "type": "string",
      "enum": ["enabled", "block", "warn", "disabled"],
      "description": "`enabled` and `block` are aliases (both mean: hook fires and blocks on violation). `warn` lets the offending action through but logs to the relevant check report. `disabled` skips the hook entirely."
    },
    "project_type": {
      "type": "string",
      "enum": ["paper", "patent", "mixed"]
    },
    "external_agent": {
      "type": "string",
      "enum": ["codex", "claude-bare", "opencode"]
    },
    "lit_provider": {
      "type": "string",
      "enum": ["arxiv", "semantic-scholar", "openalex"]
    }
  }
}
