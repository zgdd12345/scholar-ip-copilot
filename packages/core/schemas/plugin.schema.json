{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-ip-copilot/schemas/plugin.schema.json",
  "title": "EviDraft v2 plugin manifest",
  "type": "object",
  "required": [
    "id",
    "manifest_version",
    "name",
    "version",
    "description",
    "entrypoints",
    "adapters",
    "workflows"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "const": "scholar" },
    "manifest_version": { "const": "2.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "const": "2.0.0" },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["workflows", "roles", "policies", "capabilities", "templates"],
      "additionalProperties": false,
      "properties": {
        "workflows": { "const": "workflows/" },
        "roles": { "const": "roles/roles.yaml" },
        "policies": { "const": "policies/policy.yaml" },
        "capabilities": { "const": "capabilities/" },
        "templates": { "const": "templates/" }
      }
    },
    "project_types": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["paper", "patent", "mixed"] }
    },
    "adapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/adapter" }
    },
    "mcp_servers": { "type": "array", "maxItems": 0 },
    "workflows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/workflow" }
    },
    "naming": {
      "type": "object",
      "required": ["claude", "codex", "opencode"],
      "additionalProperties": false,
      "properties": {
        "claude": { "type": "string" },
        "codex": { "type": "string" },
        "opencode": { "type": "string" }
      }
    },
    "output_contracts": {
      "type": "object",
      "required": ["evidence_root", "manuscript_root", "submission_root"],
      "additionalProperties": false,
      "properties": {
        "evidence_root": { "const": ".evidraft/" },
        "manuscript_root": { "const": "manuscript/" },
        "submission_root": { "const": "submissions/" }
      }
    },
    "paper_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_style": { "type": "string" },
        "supported_venues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "patent_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_deliverable": { "type": "string" },
        "jurisdictions": {
          "type": "array",
          "items": { "enum": ["US", "EP", "CN", "JP", "PCT", "OTHER"] }
        }
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "required": ["id", "status", "out"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["claude-code", "codex-cli", "opencode"] },
        "status": { "const": "stable" },
        "out": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["id", "actions"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["using", "scope", "research", "paper", "patent", "polish", "xreview"] },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
