# EviDraft scratch (only inside example/test workspaces, not the repo root)
**/.evidraft/cache/
**/.evidraft/.cache/
**/.evidraft/tmp/

# Trial scaffolds at the repo root. The plugin repo itself is not an
# EviDraft project; when /scholar:paper-init or similar is run here
# during a trial, the resulting .evidraft/ + manuscript/ trees are
# trial output, not source.
/.evidraft/
/manuscript/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
