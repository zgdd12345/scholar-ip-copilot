# Rendered adapter outputs (regenerated by `make render` / `make install`).
# The .agents/plugins/marketplace.json source IS tracked; only .agents/skills/ is rendered.
.claude
.codex
.opencode/commands/
.opencode/agents/
.opencode/skills/
.opencode/README.md
# OpenCode bun/npm runtime artefacts (the nested .opencode/.gitignore OpenCode
# writes covers most of these but not package-lock.json).
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.agents/skills/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example

# Build / dist
build/
dist/
*.egg

# IDEs
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# LaTeX build artefacts (examples may compile locally)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot

# EviDraft scratch (only inside example/test workspaces, not the repo root)
**/.evidraft/cache/
**/.evidraft/.cache/
**/.evidraft/tmp/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
